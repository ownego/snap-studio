# generated per-machine by snap-bridge/native-host/install.ps1 (Windows) or
# install.sh (macOS/Linux): absolute paths, node location, and this profile's
# unpacked extension id. On macOS/Linux the manifest is installed into the
# browser's own NativeMessagingHosts dir, so only the shim lands here.
snap-bridge/native-host/com.snapstudio.bridge.json
snap-bridge/native-host/snap-bridge-host.cmd
snap-bridge/native-host/snap-bridge-host.sh
snap-bridge/logs/

# private half of manifest.json's "key" (pins the extension id — see
# EXTENSION_ID in snap-bridge/server.js). Only the public derivative goes
# into manifest.json; the .pem itself must never leave this machine.
manifest-key.pem
